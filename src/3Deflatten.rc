#include <windows.h>
#include "resource.h"

STRINGTABLE
BEGIN
    IDS_PROP_TITLE  "3Deflatten"
END

IDD_PROP_PAGE DIALOGEX 0, 0, 298, 444
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 1
BEGIN
    // Stereo Parameters
    GROUPBOX  "Stereo Parameters", -1,              4,   2, 290,  94
    LTEXT     "Convergence (screen-plane depth, 0-1):", -1, 10, 14, 200, 10
    CONTROL   "", IDC_CONV_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE,  10,  24, 242,  14
    LTEXT     "0.250", IDC_CONV_LABEL,             256,  24,  32,  14, SS_RIGHT
    LTEXT     "Separation (stereo strength, 0-0.20):", -1, 10, 44, 200, 10
    CONTROL   "", IDC_SEP_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE,  10,  54, 242,  14
    LTEXT     "0.050", IDC_SEP_LABEL,              256,  54,  32,  14, SS_RIGHT
    LTEXT     "Temporal Smoothing (0=off; disabled when streaming):", -1, 10, 74, 200, 10
    CONTROL   "", IDC_SMOOTH_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE,  10,  84, 242,  14
    LTEXT     "0.00", IDC_SMOOTH_LABEL,            256,  84,  32,  14, SS_RIGHT

    // Output (Mode + Flip + Depth overlay + Infill)
    GROUPBOX  "Output",    -1,                      4, 102, 140,  66
    LTEXT     "Mode:",     -1,                     10, 115,  28,  10
    COMBOBOX  IDC_MODE_COMBO,                      40, 113, 100,  60,
              CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Flip Depth",    IDC_FLIP_CHECK,  10, 129, 130,  12
    AUTOCHECKBOX "Show Depth Map (Right Shift)",
                                   IDC_DEPTH_CHECK, 10, 143, 130,  12
    LTEXT     "Infill:",   -1,                     10, 159,  28,  10
    COMBOBOX  IDC_INFILL_COMBO,                    40, 157, 100,  60,
              CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // Inference (Runtime + Provider + Depth Dim + Mesh Div)
    GROUPBOX  "Inference", -1,                    150, 102, 144,  84
    LTEXT     "Runtime:",  -1,                    156, 115,  36,  10
    COMBOBOX  IDC_RUNTIME_COMBO,                  194, 113,  94,  50,
              CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT     "Provider:", IDC_PROVIDER_LABEL,    156, 131,  36,  10
    COMBOBOX  IDC_GPU_COMBO,                      194, 129,  94,  80,
              CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT     "Depth dim:",-1,                    156, 147,  36,  10
    COMBOBOX  IDC_DEPTHDIM_COMBO,                 194, 145,  94,  60,
              CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT     "Mesh res:", -1,                    156, 163,  36,  10
    COMBOBOX  IDC_MESHDIV_COMBO,                  194, 161,  94,  60,
              CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // Depth Post-processing (Upscale algorithm + Dilation + Edge Threshold + Mesh Cut)
    // Height 70 = 14 (upscale) + 14 (dilate) + 14 (thresh) + 14 (mesh cut) + 14 padding
    GROUPBOX  "Depth Post-processing", -1,          4, 174, 290,  84
    LTEXT     "Upscale:", -1,                       10, 186,  40,  10
    COMBOBOX  IDC_UPSCALE_COMBO,                    52, 184, 232,  60,
              CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT     "Edge Dilate (0-16 px):", -1,         10, 202, 100,  10
    CONTROL   "", IDC_DILATE_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE, 110, 202, 130,  12
    LTEXT     "4 px", IDC_DILATE_LABEL,            244, 202,  24,  10, SS_RIGHT
    LTEXT     "Edge Threshold (0-1):",  -1,         10, 216, 100,  10
    CONTROL   "", IDC_EDGETHRESH_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE, 110, 216, 130,  12
    LTEXT     "0.20", IDC_EDGETHRESH_LABEL,        244, 216,  24,  10, SS_RIGHT
    LTEXT     "Mesh Cut Thresh (0-1):", -1,         10, 230, 100,  10
    CONTROL   "", IDC_DISCTHRESH_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE, 110, 230, 130,  12
    LTEXT     "0.10", IDC_DISCTHRESH_LABEL,        244, 230,  24,  10, SS_RIGHT
    LTEXT     "WMF Dilate Inset (0-8 px):", -1,    10, 244, 110,  10
    CONTROL   "", IDC_WMFINSET_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE, 120, 244, 120,  12
    LTEXT     "2 px", IDC_WMFINSET_LABEL,          244, 244,  24,  10, SS_RIGHT

    // ONNX Model + DA3-Streaming checkbox
    GROUPBOX  "ONNX Model", -1,                     4, 264, 290,  58
    LTEXT     "File:",     -1,                     10, 278,  20,  10
    COMBOBOX  IDC_MODEL_COMBO,                     32, 276, 200,  80,
              CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Reload",   IDC_RELOAD_BTN,        236, 274,  52,  14
    AUTOCHECKBOX "DA3-Streaming  (temporal alignment, uses da3-small.onnx)",
              IDC_STREAM_CHECK,                    10, 293, 278,  12
    LTEXT     "Switching model or provider takes effect after Reload.", -1,
                                                   10, 307, 278,  10

    // Apply row
    // Mesh Inspector (debug) — translate viewport and rotate mesh
    GROUPBOX  "Mesh Inspector (debug)", -1,              4, 326, 290,  70
    LTEXT     "Translate X (-1..1):", -1,               10, 338,  80,  10
    CONTROL   "", IDC_INSP_TX_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE,      92, 338, 148,  12
    LTEXT     "0.00", IDC_INSP_TX_LABEL,              244, 338,  32,  10, SS_RIGHT
    LTEXT     "Translate Y (-1..1):", -1,               10, 352,  80,  10
    CONTROL   "", IDC_INSP_TY_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE,      92, 352, 148,  12
    LTEXT     "0.00", IDC_INSP_TY_LABEL,              244, 352,  32,  10, SS_RIGHT
    LTEXT     "Translate Z (-0.5..0.5):", -1,           10, 366,  80,  10
    CONTROL   "", IDC_INSP_TZ_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE,      92, 366, 148,  12
    LTEXT     "0.00", IDC_INSP_TZ_LABEL,              244, 366,  32,  10, SS_RIGHT
    LTEXT     "Rotate Y (-90..90 deg):", -1,            10, 380,  80,  10
    CONTROL   "", IDC_INSP_RY_SLIDER, "msctls_trackbar32",
              TBS_NOTICKS | WS_CHILD | WS_VISIBLE,      92, 380, 148,  12
    LTEXT     "0 deg", IDC_INSP_RY_LABEL,             244, 380,  32,  10, SS_RIGHT

    PUSHBUTTON "Apply All + Reload", IDC_APPLY_BTN,  4, 400, 290, 14

    // Status
    GROUPBOX  "Active Inference Status", -1,        4, 418, 290,  24
    LTEXT     "", IDC_GPU_INFO,                    10, 428, 278,  12,
              SS_NOPREFIX | SS_ENDELLIPSIS
END
